#!/usr/bin/env sh

# 1. Edge-case guards
# Skip bump on merge commits, rebases, cherry-picks
if [ -f .git/MERGE_HEAD ] || [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ] || [ -f .git/CHERRY_PICK_HEAD ]; then
  exit 0
fi

# Skip bump on git commit --amend (inspect parent process arguments)
if ps -o args= -p $PPID 2>/dev/null | grep -q -- '--amend'; then
  exit 0
fi

# Skip bump if no staged changes (empty commit or aborted before staging)
if git diff --cached --quiet; then
  exit 0
fi

# 2. Run lint-staged and code quality checks FIRST.
# If these fail, commit aborts BEFORE any version bump is applied.
pnpm exec lint-staged || exit 1
pnpm run format:check || exit 1

# 3. Auto-bump version across all carriers
node scripts/bump-version.mjs || exit 1

# 4. Verify version consistency across all carriers
node scripts/check-version.mjs || exit 1

# 5. Rebuild CLI binary with newly bumped version
node scripts/build-cli.mjs || exit 1

# 6. Stage updated carriers and built CLI so the bump lands in the same commit
git add VERSION package.json power/plugin.json src/version.ts dist/cli.js
