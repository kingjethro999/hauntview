{
  "name": "hauntview",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Local-first website resilience, accessibility, failure-mode and visual regression testing with Playwright and MCP.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node init && next dev --hostname 127.0.0.1",
    "postinstall": "node scripts/postinstall.mjs",
    "build": "node init && next build",
    "start": "node init && next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "test": "pnpm run test:unit",
    "test:unit": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:all": "pnpm run test:unit && pnpm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "browsers:install": "playwright install chromium firefox webkit",
    "mcp": "tsx src/mcp/server.ts",
    "presubmit": "node scripts/presubmit.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/check-version.mjs",
    "setup:hooks": "husky",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write",
      "eslint"
    ],
    "*.{json,md,mdx,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/jszip": "^3.4.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ipaddr.js": "^2.5.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.69.0",
    "next": "16.4.3",
    "nextjs-toploader": "^3.9.17",
    "p-limit": "^7.3.3",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.4",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
